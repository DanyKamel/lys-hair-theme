{% comment %}
  LYS HAIR — Reviews Section
  Photo reviews grid with star rating + verified badge
  Psychology: Social proof, third-party validation
{% endcomment %}

<section class="lys-reviews" id="reviews">
  <div class="lys-reviews__inner">
    <div class="lys-reviews__head">
      <span class="lys-reviews__eyebrow">REAL CUSTOMERS · REAL RESULTS</span>
      <h2 class="lys-reviews__title">{{ section.settings.title }}</h2>
      <div class="lys-reviews__summary">
        <span class="lys-stars">★★★★★</span>
        <strong>4.9 / 5</strong>
        <span>·</span>
        <span>Based on {{ section.settings.review_count }} reviews</span>
      </div>
    </div>

    <div class="lys-reviews__grid">
      {% for block in section.blocks %}
        <article class="lys-review">
          {% if block.settings.image != blank %}
            <div class="lys-review__img">
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="" loading="lazy">
            </div>
          {% endif %}
          <div class="lys-review__body">
            <div class="lys-review__head">
              <span class="lys-stars">★★★★★</span>
              <span class="lys-review__verified">✓ Verified</span>
            </div>
            <h3 class="lys-review__title">{{ block.settings.headline }}</h3>
            <p class="lys-review__text">"{{ block.settings.body }}"</p>
            <p class="lys-review__author">
              <strong>{{ block.settings.author }}</strong>
              <span>{{ block.settings.location }}</span>
            </p>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="lys-reviews__cta">
      <a href="/pages/reviews" class="lys-btn lys-btn--ghost-dark">READ ALL {{ section.settings.review_count }} REVIEWS</a>
    </div>
  </div>
</section>

<style>
  .lys-reviews {
    padding: 100px 0;
    background: #F5EFE6;
    font-family: 'Jost', sans-serif;
  }
  .lys-reviews__inner { max-width: 1400px; margin: 0 auto; padding: 0 24px; }
  .lys-reviews__head { text-align: center; margin-bottom: 60px; }
  .lys-reviews__eyebrow {
    display: block;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: #C9A97A;
    margin-bottom: 16px;
  }
  .lys-reviews__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    margin: 0 0 20px;
    color: #1A1410;
  }
  .lys-reviews__summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #2E2820;
  }
  .lys-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) { .lys-reviews__grid { grid-template-columns: 1fr; } }
  .lys-review {
    background: #FFFFFF;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .lys-review:hover { transform: translateY(-4px); }
  .lys-review__img img {
    width: 100%; aspect-ratio: 4/5;
    object-fit: cover; display: block;
  }
  .lys-review__body { padding: 24px; }
  .lys-review__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .lys-review__verified {
    font-size: 11px;
    color: #C9A97A;
    letter-spacing: 0.1em;
  }
  .lys-review__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 400;
    margin: 0 0 10px;
    color: #1A1410;
  }
  .lys-review__text {
    font-size: 14px;
    line-height: 1.7;
    color: #2E2820;
    margin: 0 0 16px;
  }
  .lys-review__author { font-size: 12px; margin: 0; color: #1A1410; }
  .lys-review__author strong { display: block; }
  .lys-review__author span { color: #A89070; }
  .lys-reviews__cta { text-align: center; margin-top: 50px; }
  .lys-btn--ghost-dark {
    background: transparent;
    color: #1A1410;
    border: 1px solid #1A1410;
  }
  .lys-btn--ghost-dark:hover { background: #1A1410; color: #F5EFE6; }
</style>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "10,000+ women have transformed their hair" },
    { "type": "text", "id": "review_count", "label": "Total review count", "default": "2,847" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Genuinely undetectable" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "I've tried 5 brands and these are the only ones nobody can tell aren't mine. Worth every dollar." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sarah M." },
        { "type": "text", "id": "location", "label": "Location", "default": "Melbourne, AU" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
