{% comment %}
  LYS HAIR — Inline Email Capture
  Above the footer
  Psychology: Future commitment, reciprocity (early access)
{% endcomment %}

<section class="lys-capture">
  <div class="lys-capture__inner">
    <h2 class="lys-capture__title">{{ section.settings.title }}</h2>
    <p class="lys-capture__sub">{{ section.settings.subtitle }}</p>
    {% form 'customer', class: 'lys-capture__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="your@email.com" required>
      <button type="submit" class="lys-btn lys-btn--primary">JOIN THE LIST</button>
    {% endform %}
    <p class="lys-capture__note">{{ section.settings.note }}</p>
  </div>
</section>

<style>
  .lys-capture {
    padding: 90px 0;
    background: #1A1410;
    color: #F5EFE6;
    font-family: 'Jost', sans-serif;
    text-align: center;
  }
  .lys-capture__inner { max-width: 600px; margin: 0 auto; padding: 0 24px; }
  .lys-capture__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 300;
    margin: 0 0 14px;
  }
  .lys-capture__sub {
    color: rgba(245,239,230,0.75);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .lys-capture__form {
    display: flex;
    gap: 0;
    max-width: 460px;
    margin: 0 auto;
  }
  .lys-capture__form input {
    flex: 1;
    padding: 16px 18px;
    background: transparent;
    border: 1px solid rgba(245,239,230,0.3);
    color: #F5EFE6;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
  }
  .lys-capture__form input:focus { outline: none; border-color: #C9A97A; }
  .lys-capture__form button { flex-shrink: 0; }
  .lys-capture__note {
    margin-top: 16px;
    font-size: 11px;
    color: rgba(245,239,230,0.5);
    letter-spacing: 0.1em;
  }
</style>

{% schema %}
{
  "name": "Email Capture",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "First access. Best price." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Join the list for 10% off your first order, exclusive restocks, and new shade launches before anyone else." },
    { "type": "text", "id": "note", "label": "Footnote", "default": "NO SPAM. UNSUBSCRIBE ANY TIME." }
  ],
  "presets": [{ "name": "Email Capture" }]
}
{% endschema %}
